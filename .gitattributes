# Cross-OS Git policy for a shared Windows/Ubuntu working tree.
# Store text with LF line endings and keep known binary formats untouched.

* text=auto eol=lf

###############################################################################
# Repository metadata and documentation
###############################################################################
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
*.gitignore text eol=lf
*.md text eol=lf
*.markdown text eol=lf
*.rst text eol=lf
*.txt text eol=lf
*.diff text eol=lf
*.patch text eol=lf

